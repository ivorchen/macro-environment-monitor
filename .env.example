# Create a free key at https://fredaccount.stlouisfed.org/apikeys
# Keep the real value in .env.local; never commit it.
FRED_API_KEY=

# Optional: raises the BLS daily query allowance from 25 to 500.
BLS_API_KEY=

# Free keys for optional public adapters. Their indicators stay hidden until enabled.
BEA_API_KEY=
CENSUS_API_KEY=

# Optional licensed end-of-day market data. Its indicators stay hidden until enabled.
# The account plan must permit the intended use.
FMP_API_KEY=

# Shared cache. Required when FMP is enabled so its daily quota is protected.
# Supports redis:// and rediss:// connection URLs.
REDIS_URL=
REDIS_KEY_PREFIX=macro-monitor
